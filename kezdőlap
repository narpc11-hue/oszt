package com.example.classroom.controller;

import com.example.classroom.model.Classroom;
import com.example.classroom.repository.ClassroomRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;

import java.util.List;

@Controller
public class HomeController {

    @Autowired
    private ClassroomRepository classroomRepository;

    /**
     * A webalkalmazás kezdőlapja (Gyökér URL: /)
     */
    @GetMapping("/")
    public String homePage(Model model) {
        // Lekérdezzük az összes elmentett osztályt az adatbázisból.
        // Mivel ez egy központi adatbázisból jön, minden eszközön ugyanazokat az adatokat fogja mutatni.
        List<Classroom> classrooms = classroomRepository.findAll();
        
        // Hozzáadjuk a listát a modellhez, hogy a HTML (Thymeleaf) ki tudja rajzolni
        model.addAttribute("classrooms", classrooms);
        
        // Visszaadjuk az index.html sablont a kezdőképernyőhöz
        return "index";
    }
}
